VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Compte Supabase réel utilisé en coulisses quand quelqu'un se connecte avec
# l'identifiant/mdp "admin" sur l'écran de connexion.
VITE_ADMIN_EMAIL=admin@your-domain.fr
VITE_ADMIN_PASSWORD=set-a-real-password-here

# Liens réseaux sociaux affichés sur la page d'accueil publique (optionnels :
# le bouton correspondant n'apparaît pas si la variable est absente).
VITE_FACEBOOK_URL=https://facebook.com/A-REMPLACER
VITE_INSTAGRAM_URL=https://instagram.com/A-REMPLACER

# Lien vers le site de recrutement du SDIS, utilisé sur la page /recrutement
# quand un candidat n'est pas éligible pour ce centre (ex: hors périmètre
# géographique) mais peut l'être pour un autre centre du département.
VITE_SDIS_RECRUTEMENT_URL=https://www.sdis59.fr/sengager/sapeurs-pompiers-volontaires/

# Clé publique VAPID pour les notifications push (voir scripts/generate-vapid-keys.mjs).
VITE_VAPID_PUBLIC_KEY=generated-with-scripts/generate-vapid-keys.mjs
